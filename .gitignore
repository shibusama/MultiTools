# ==========================================================================
# MultiTools .gitignore
#
# 目录约定（两级：项目 → 类型）：
#
#   projects/<项目>/          项目产物与脚本
#     zhuyizhuyi/  raw/ cleaned/ filtered/ index/
#     chiikawa/    scripts/ models/ renders/
#     dex/         scripts/ renders/
#   data/        采集残留与本机素材（audio/ video/ douyin/）
#   outputs/     跨项目产物（frames/ media/ reports/ subtitles/）
#   ebook-txt/   电子书抽取输出
#   skills/ scripts/ models/ tools/   代码与工具
#
# 规则顺序：全局规则在前，项目特例在后（后匹配者生效）。
# 注意：.gitignore 不支持行内注释，注释必须独占一行。
# ==========================================================================


# --------------------------------------------------------------------------
# 1. 凭据 / 登录态
# --------------------------------------------------------------------------
*cookie*
*cookies*
browser_profile/
.env
.env.*
!.env.example
*.pem
*.key
*.session


# --------------------------------------------------------------------------
# 2. 媒体与二进制（按类型拦截）
# --------------------------------------------------------------------------
*.mp3
*.mp4
*.wav
*.m4a
*.webm
*.flac
*.mkv
*.avi
*.mov
*.m4s
*.aac
*.ogg
*.opus

*.exe
*.dll
*.onnx
*.pt
*.pth
*.safetensors
*.gguf
*.bin

__pycache__/
*.py[cod]
.venv/
venv/


# --------------------------------------------------------------------------
# 3. 本机素材与产物目录（跨项目）
# --------------------------------------------------------------------------
data/
outputs/
.work/
.ocr_cache/
_tmp*
*.log
*.srt
*.lrc


# --------------------------------------------------------------------------
# 4. 大文件与外部工具（保留本机，不上传）
#    models/ 约 2.9 GB，tools/ 约 4.5 GB
# --------------------------------------------------------------------------
models/
tools/archives/
tools/faster-whisper-xxl/

# 例外：chiikawa 的 .blend 模型仅 5.4 MB，入库
!projects/chiikawa/models/


# --------------------------------------------------------------------------
# 5. projects/ 各项目
# --------------------------------------------------------------------------
# --- 主义主义：讲座转写稿入库（raw/ cleaned/ filtered/ index/） ---
# --- douyin-transcripts：自己的视频转写稿，入库 ---

# --- chiikawa：帧序列可重渲，采集 json 含会过期的签名直链 ---
projects/chiikawa/renders/
projects/chiikawa/douyin_tutorials.json
*.blend1

# --- dex：渲染成片与预览图 ---
projects/dex/renders/


# --------------------------------------------------------------------------
# 6. 电子书抽取
# --------------------------------------------------------------------------
# 抽取产物入库（txt/ 与 .work/ 都在版本控制内）
# inbox/ 放待处理的原始 epub/pdf，是输入不是产物，仍忽略
ebook-txt/inbox/


# --------------------------------------------------------------------------
# 7. 抖音采集（skills/douyin-collect/）
# --------------------------------------------------------------------------
skills/douyin-collect/data/
skills/douyin-collect/transcripts/
skills/douyin-collect/audio/
skills/douyin-collect/browser_profile/

bili_search.json
dy_*.html


# --------------------------------------------------------------------------
# 8. 编辑器 / 操作系统
# --------------------------------------------------------------------------
.claude/
.cursor/
.DS_Store
Thumbs.db
Desktop.ini
