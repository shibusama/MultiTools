# ==========================================================================
# MultiTools .gitignore
#
# 组织方式：先「全局规则」（任何目录都生效），再「按项目 / 按类型」分组。
# 目录结构约定（两级：项目 → 类型）：
#
#   <项目>/                    产物与工具留在本机，不进 git
#     ├─ audio/  transcripts/  原始素材与转写稿
#     ├─ outputs/ renders/     中间产物与渲染帧
#     └─ models/               模型与二进制
#
#   全局（跨项目）：
#     audio/  transcripts/  txt/  outputs/  analysis_videos/
#     models/  tools/  ebook-txt/
#
# 注意：忽略规则写在目录内部时，git 不会把顶层目录标成 ignored（这很正常），
# 但目录里的文件确实全部被挡住了。
# ==========================================================================


# --------------------------------------------------------------------------
# 1. 全局：凭据 / 登录态（任何项目都不入库）
# --------------------------------------------------------------------------
*cookie*
*cookies*
browser_profile/
.env
.env.*
!.env.example
*.pem
*.key
*.session


# --------------------------------------------------------------------------
# 2. 全局：媒体与二进制（按类型拦截，任何项目都不入库）
# --------------------------------------------------------------------------
# 音视频源文件
*.mp3
*.mp4
*.wav
*.m4a
*.webm
*.flac
*.mkv
*.avi
*.mov
*.m4s
*.aac
*.ogg
*.opus

# 模型 / 可执行 / 二进制权重
*.exe
*.dll
*.onnx
*.pt
*.pth
*.safetensors
*.gguf
*.bin

# Python 运行时产物
__pycache__/
*.py[cod]
.venv/
venv/


# --------------------------------------------------------------------------
# 3. 全局：输出与临时目录（跨项目通用）
# --------------------------------------------------------------------------
audio/
outputs/
analysis_videos/
transcripts/
txt/
.work/
.ocr_cache/
_tmp*
*.log
*.srt
*.lrc


# --------------------------------------------------------------------------
# 4. 全局：大文件与第三方工具（保留本机，不上传）
#    tools/ 共约 4.5 GB、models/ 约 2.9 GB
# --------------------------------------------------------------------------
models/
tools/archives/
tools/faster-whisper-xxl/

# 例外：chiikawa 项目的 .blend 模型仅 5.4 MB，入库
!chiikawa动画制作/models/


# --------------------------------------------------------------------------
# 5. 项目：主义主义（B 站讲座转写，约 22 MB 纯文本）
# --------------------------------------------------------------------------
主义主义_340/
主义主义_340_清洗/
主义主义_过滤内容/
主义主义_BV列表.txt
主义主义_视频清单.csv
未明子_全部视频清单.csv


# --------------------------------------------------------------------------
# 6. 项目：chiikawa 动画制作
# --------------------------------------------------------------------------
# 帧序列与预览图，约 108 MB，可重渲
chiikawa动画制作/renders/
# 采集数据，含会过期的签名直链
chiikawa动画制作/douyin_tutorials.json
# Blender 自动备份
*.blend1


# --------------------------------------------------------------------------
# 7. 项目：电子书抽取（ebook-txt/）
# --------------------------------------------------------------------------
ebook-txt/txt/
ebook-txt/inbox/
ebook-txt/.work/


# --------------------------------------------------------------------------
# 8. 项目：抖音采集（skills/douyin-collect/）
# --------------------------------------------------------------------------
skills/douyin-collect/data/
skills/douyin-collect/transcripts/
skills/douyin-collect/audio/
skills/douyin-collect/browser_profile/

# 采集残留
bili_search.json
dy_*.html


# --------------------------------------------------------------------------
# 9. 编辑器 / 操作系统
# --------------------------------------------------------------------------
.claude/
.cursor/
.DS_Store
Thumbs.db
Desktop.ini
